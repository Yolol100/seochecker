{
  "schema_version": "1.0",
  "controller": "webactueel-workflow",
  "repository": "Yolol100/seochecker",
  "repo_class": "core",
  "role": "technical-seo-evidence",
  "owner_skill": "seo",
  "profile_scope": "generic_capability",
  "project_truth": {
    "authority": "Project SEO live manifest",
    "must_not_be_stored_in_repo": true
  },
  "master_rule_ids": [
    "repo.profile.contract",
    "repo.role.boundary",
    "repo.hygiene",
    "repo.tests",
    "repo.provenance",
    "repo.dependencies"
  ],
  "capability_evidence": [
    "http-indexability",
    "crawl",
    "lighthouse-lab",
    "markup-validation",
    "technical-seo-evidence"
  ],
  "validation": {
    "commands": [
      "python3 -m unittest discover -s tests -v",
      "python3 -m py_compile scripts/*.py tests/*.py"
    ],
    "workflow_gates": [
      "SEO Audit"
    ]
  },
  "evidence_contract": {
    "commit_sha": true,
    "result_readback": true,
    "artifact_or_result_identity": true,
    "owner_acceptance": true
  },
  "closure_contract": {
    "repo_success_is_not_workflow_complete": true,
    "temporary_target_evidence_off_default_branch": true,
    "project_truth_off_default_branch": true
  }
}
