{
  "schema_version": "1.4",
  "owner_skill": "seo",
  "project_id": "project-seo",
  "repository": "Yolol100/seochecker",
  "evidence_role": "controlled_runtime_technical_seo",
  "requires_account": false,
  "requires_api_key": false,
  "requires_mcp": false,
  "tools": [
    {
      "id": "core-indexability",
      "version": "repo",
      "trigger_when": "every technical audit",
      "outputs": ["reports/basic-seo.json"]
    },
    {
      "id": "siteone",
      "version": "2.5.1",
      "trigger_when": "every technical audit",
      "outputs": ["reports/siteone.json", "reports/siteone.html"]
    },
    {
      "id": "siteone-browser",
      "version": "2.5.1",
      "trigger_when": "rendered DOM evidence can change the technical SEO decision",
      "outputs": ["reports/siteone-rendered.json", "reports/siteone-rendered.html"]
    },
    {
      "id": "bounded-url-list",
      "version": "1",
      "trigger_when": "the SEO owner supplies a bounded runtime URL set from GSC, Ahrefs, sitemap or another source",
      "outputs": ["reports/runtime-urls.txt"]
    },
    {
      "id": "technical-evidence",
      "version": "1.0",
      "trigger_when": "technical crawl output must be consumed by another skill or compared across runs",
      "outputs": ["reports/technical-findings.json", "reports/technical-graph.json", "reports/regression-diff.json"]
    },
    {
      "id": "lighthouse-ci",
      "version": "0.15.1",
      "trigger_when": "every technical audit",
      "outputs": ["reports/lighthouse-summary.json", ".lighthouseci/"]
    },
    {
      "id": "nu-html-checker",
      "version": "asset-515207969",
      "sha256": "c70279e260e5f4f9e95b3890ef6c9548f90ebdaec2a75219ec41694ab6241e34",
      "trigger_when": "every technical audit",
      "outputs": ["reports/w3c-nu.json"]
    },
    {
      "id": "evidence-manifest",
      "version": "1.1",
      "trigger_when": "every technical audit",
      "outputs": ["reports/evidence-manifest.json"]
    },
    {
      "id": "page-expectations",
      "version": "2",
      "trigger_when": "explicit post-publication expectations are supplied",
      "outputs": ["caller-selected JSON report"]
    }
  ],
  "input_contract": {
    "owner": "seo",
    "runtime_only": true,
    "allowed": [
      "single public target URL",
      "bounded public URL list selected by SEO from GSC/Ahrefs/sitemap/other evidence",
      "optional previous normalized technical-findings artifact for regression comparison",
      "optional sitemap URL list for reconciliation"
    ],
    "forbidden_on_main": [
      "client or site-specific URL inventories",
      "GSC exports",
      "Ahrefs exports",
      "source-set snapshots",
      "run-specific evidence"
    ]
  },
  "usage_assertions": [
    {"tool": "core-indexability", "path": ".github/workflows/seo-audit.yml", "contains": "seo_basic_check.py"},
    {"tool": "siteone", "path": ".github/workflows/seo-audit.yml", "contains": "siteone-crawler"},
    {"tool": "siteone-browser", "path": ".github/workflows/seo-audit.yml", "contains": "--browser"},
    {"tool": "bounded-url-list", "path": ".github/workflows/seo-audit.yml", "contains": "runtime-urls.txt"},
    {"tool": "technical-evidence", "path": ".github/workflows/seo-audit.yml", "contains": "technical_evidence.py"},
    {"tool": "lighthouse-ci", "path": ".github/workflows/seo-audit.yml", "contains": "lighthouse_summary.py"},
    {"tool": "nu-html-checker", "path": ".github/workflows/seo-audit.yml", "contains": "VNU_ASSET_ID"},
    {"tool": "evidence-manifest", "path": ".github/workflows/seo-audit.yml", "contains": "build_evidence_manifest.py"},
    {"tool": "page-expectations", "path": "scripts/verify_page_expectations.py", "contains": "def load_pages"}
  ],
  "boundaries": [
    "GSC remains authoritative for owned Google Search performance and Google's observed index status.",
    "Ahrefs remains authoritative only for its own market, keyword, backlink and competitive datasets.",
    "This repository owns reproducible technical observations, normalized technical evidence and regression comparison only.",
    "Rendered browser evidence and HTTP-response evidence must retain separate observation-layer labels.",
    "External URL selection does not import external source semantics into repository output.",
    "Tool findings are diagnostics; SEO owns interpretation and prioritization.",
    "The evidence manifest records provenance and artifacts; it does not replace Project SEO source truth.",
    "Client, target and run-specific truth belongs in runtime input or artifacts, not permanently on main.",
    "Post-publication checks require non-empty typed expectations and preserve URL resource identity."
  ]
}
